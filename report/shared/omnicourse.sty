%% omnicourse.sty -- OmniCourse report style v2.0
%% A modern, elegant design inspired by Stripe/Linear/Apple design docs
%% Build with XeLaTeX (fontspec, system fonts, Vietnamese support)
\NeedsTeXFormat{LaTeX2e}
\ProvidesFile{omnicourse.sty}[2026/10/25 v2.0 OmniCourse report style]

\RequirePackage{fontspec}

%% ---------------------------------------------------------------- language
\IfFileExists{polyglossia.sty}{
  \RequirePackage{polyglossia}
  \setmainlanguage{english}
}{
  \RequirePackage[english]{babel}
}

%% ---------------------------------------------------------------- fonts
%% Cross-platform font fallback (Windows, macOS, Linux/TeX Live, Docker)
%% Guarantees successful compilation without "font not found" errors on any OS.

%% Main serif font (Palatino lineage)
\IfFontExistsTF{Palatino Linotype}{
  \setmainfont{Palatino Linotype}
}{
  \IfFontExistsTF{Palatino}{
    \setmainfont{Palatino}
  }{
    \IfFontExistsTF{TeX Gyre Pagella}{
      \setmainfont{TeX Gyre Pagella}
    }{
      \IfFontExistsTF{Liberation Serif}{
        \setmainfont{Liberation Serif}
      }{
        \IfFontExistsTF{DejaVu Serif}{
          \setmainfont{DejaVu Serif}
        }{
          \setmainfont{Latin Modern Roman}
        }
      }
    }
  }
}

%% Sans-serif font (Segoe / Helvetica / Neutral Sans lineage)
\IfFontExistsTF{Segoe UI}{
  \setsansfont{Segoe UI}
}{
  \IfFontExistsTF{SF Pro Display}{
    \setsansfont{SF Pro Display}
  }{
    \IfFontExistsTF{TeX Gyre Heros}{
      \setsansfont{TeX Gyre Heros}
    }{
      \IfFontExistsTF{Helvetica Neue}{
        \setsansfont{Helvetica Neue}
      }{
        \IfFontExistsTF{Liberation Sans}{
          \setsansfont{Liberation Sans}
        }{
          \IfFontExistsTF{DejaVu Sans}{
            \setsansfont{DejaVu Sans}
          }{
            \setsansfont{Latin Modern Sans}
          }
        }
      }
    }
  }
}

%% Monospace font (Consolas / Menlo / Code lineage)
\IfFontExistsTF{Consolas}{
  \setmonofont{Consolas}[Scale=0.90]
}{
  \IfFontExistsTF{Menlo}{
    \setmonofont{Menlo}[Scale=0.90]
  }{
    \IfFontExistsTF{TeX Gyre Cursor}{
      \setmonofont{TeX Gyre Cursor}[Scale=0.90]
    }{
      \IfFontExistsTF{Liberation Mono}{
        \setmonofont{Liberation Mono}[Scale=0.90]
      }{
        \IfFontExistsTF{DejaVu Sans Mono}{
          \setmonofont{DejaVu Sans Mono}[Scale=0.90]
        }{
          \setmonofont{Latin Modern Mono}[Scale=0.90]
        }
      }
    }
  }
}

%% Heading & semibold font families
\IfFontExistsTF{Segoe UI Semibold}{
  \newfontfamily\headingfont{Segoe UI Semibold}
  \newfontfamily\semiboldfont{Segoe UI Semibold}
  \newfontfamily\lightfont{Segoe UI}
  \newfontfamily\labelfont{Segoe UI Semibold}[LetterSpace=6]
}{
  \IfFontExistsTF{Segoe UI}{
    \newfontfamily\headingfont{Segoe UI}[AutoFakeBold=1.3]
    \newfontfamily\semiboldfont{Segoe UI}[AutoFakeBold=1.3]
    \newfontfamily\lightfont{Segoe UI}
    \newfontfamily\labelfont{Segoe UI}[AutoFakeBold=1.3,LetterSpace=6]
  }{
    \IfFontExistsTF{TeX Gyre Heros}{
      \newfontfamily\headingfont{TeX Gyre Heros}
      \newfontfamily\semiboldfont{TeX Gyre Heros}
      \newfontfamily\lightfont{TeX Gyre Heros}
      \newfontfamily\labelfont{TeX Gyre Heros}[LetterSpace=6]
    }{
      \newcommand{\headingfont}{\sffamily\bfseries}
      \newcommand{\semiboldfont}{\sffamily\bfseries}
      \newcommand{\lightfont}{\sffamily}
      \newcommand{\labelfont}{\sffamily\bfseries}
    }
  }
}

%% ---------------------------------------------------------------- layout
\RequirePackage[a4paper,left=2.5cm,right=2.5cm,top=2.8cm,bottom=2.5cm,
                headheight=19pt,headsep=16pt,footskip=1.4cm]{geometry}
\RequirePackage{emptypage}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55\baselineskip}
\linespread{1.08}
\RequirePackage{microtype}
\RequirePackage{ragged2e}
\RequirePackage{needspace}

%% ---------------------------------------------------------------- colour
%% Deep charcoal + indigo accent + warm neutrals
\RequirePackage{xcolor}
\definecolor{ocNavy}{HTML}{1a1a2e}
\definecolor{ocTeal}{HTML}{6366f1}
\definecolor{ocGold}{HTML}{a78bfa}
\definecolor{ocGray}{HTML}{6b7280}
\definecolor{ocRule}{HTML}{e5e7eb}
\definecolor{ocLight}{HTML}{f8fafc}
\definecolor{ocMint}{HTML}{eef2ff}
% Additional palette
\definecolor{ocAccent}{HTML}{6366f1}
\definecolor{ocDark}{HTML}{111827}
\definecolor{ocBody}{HTML}{374151}
\definecolor{ocSubtle}{HTML}{9ca3af}
\definecolor{ocSurface}{HTML}{f9fafb}
\definecolor{ocGradA}{HTML}{1e1b4b}
\definecolor{ocGradB}{HTML}{312e81}
\definecolor{ocGradC}{HTML}{4338ca}
\definecolor{ocHdrBg}{HTML}{f1f5f9}
\definecolor{ocRowAlt}{HTML}{f8fafc}
\definecolor{ocNoteBar}{HTML}{818cf8}

%% Set default text color
\color{ocBody}

%% ---------------------------------------------------------------- titles
\RequirePackage{titlesec}

\titleformat{\section}[block]
  {\headingfont\fontsize{16}{19}\selectfont\color{ocDark}\needspace{3\baselineskip}}
  {\color{ocAccent}\thesection}{0.5em}{}
\titlespacing*{\section}{0pt}{1.6\baselineskip}{0.7\baselineskip}

\titleformat{\subsection}[block]
  {\headingfont\fontsize{13}{16}\selectfont\color{ocNavy}\needspace{2\baselineskip}}
  {\color{ocAccent!70!ocNavy}\thesubsection}{0.5em}{}
\titlespacing*{\subsection}{0pt}{1.2\baselineskip}{0.35\baselineskip}

\titleformat{\subsubsection}[block]
  {\headingfont\fontsize{11.5}{14}\selectfont\color{ocNavy}\needspace{2\baselineskip}}
  {\color{ocAccent!60!ocNavy}\thesubsubsection}{0.45em}{}
\titlespacing*{\subsubsection}{0pt}{1.0\baselineskip}{0.25\baselineskip}

%% ---------------------------------------------------------------- lists
\RequirePackage{enumitem}
\setlist[itemize]{
  label={\color{ocAccent}\raisebox{0.22ex}{\footnotesize\textbullet}},
  leftmargin=1.5em,labelsep=0.5em,itemsep=0.25em,topsep=0.35em,parsep=0pt}
\setlist[enumerate]{
  leftmargin=1.7em,labelsep=0.45em,itemsep=0.25em,topsep=0.35em,parsep=0pt,
  label={\color{ocAccent}\headingfont\arabic*.}}

%% ---------------------------------------------------------------- tables
\RequirePackage{array,tabularx,booktabs,colortbl}
\RequirePackage{xltabular}
\RequirePackage{etoolbox}
\AtBeginEnvironment{xltabular}{\RaggedRight\hyphenpenalty=10000\exhyphenpenalty=10000}
\AtBeginEnvironment{tabularx}{\RaggedRight\hyphenpenalty=10000\exhyphenpenalty=10000}
\setlength{\LTleft}{\tabcolsep}
\setlength{\LTright}{\fill}
\arrayrulecolor{ocRule}
\setlength{\arrayrulewidth}{0.4pt}
\renewcommand{\arraystretch}{1.55}
\newcolumntype{Y}{>{\RaggedRight\arraybackslash}X}

% Table header cell - light tint with bold dark text
\newcommand{\hcell}[1]{\cellcolor{ocHdrBg}{\headingfont\color{ocNavy}#1}}
\newcommand{\hdrline}{\noalign{\vspace{1.2pt}}}
\newcommand{\dlabel}[1]{\cellcolor{ocLight}{\headingfont\color{ocNavy}#1}}

% Compact layout for weekly reports
\newcommand{\ocompact}{%
  \renewcommand{\arraystretch}{1.2}%
  \titlespacing*{\section}{0pt}{0.85\baselineskip}{0.3\baselineskip}%
  \setlength{\parskip}{0.35\baselineskip}%
}

% KPI macro - large impactful number with refined label
\newcommand{\kpi}[2]{%
  {\headingfont\fontsize{22}{24}\selectfont\color{ocDark}#1}\par
  \vspace{1pt}%
  {\fontsize{7.5}{9}\selectfont\labelfont\color{ocSubtle}\MakeUppercase{#2}}%
}

%% ---------------------------------------------------------------- boxes
\RequirePackage[most]{tcolorbox}

\newtcolorbox{ocnote}[1]{enhanced,breakable,
  colback=ocMint,colframe=ocNoteBar,boxrule=0pt,leftrule=2.5pt,arc=0pt,
  left=12pt,right=12pt,top=9pt,bottom=9pt,
  fonttitle=\headingfont\small\color{ocDark},coltitle=ocDark,
  attach title to upper={\par\vspace{3pt}},
  title={#1}}

\newtcolorbox{ocplain}[1]{enhanced,breakable,
  colback=ocSurface,colframe=ocRule,boxrule=0.4pt,arc=1.5pt,
  left=12pt,right=12pt,top=9pt,bottom=9pt,
  fonttitle=\headingfont\small\color{ocDark},coltitle=ocDark,
  attach title to upper={\par\vspace{3pt}},
  title={#1}}

%% ---------------------------------------------------------------- headers / footers
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\newcommand{\docshortname}{Report}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\labelfont\color{ocSubtle}\MakeUppercase{\docshortname}}
\fancyhead[R]{\footnotesize\labelfont\color{ocSubtle}\MakeUppercase{OmniCourse}\;\textcolor{ocRule}{|}\;{\lightfont\color{ocSubtle}HCMUS 24A01}}
\fancyfoot[C]{\footnotesize\sffamily\color{ocSubtle}\thepage\;\textcolor{ocRule}{/}\;\pageref{LastPage}}
\renewcommand{\headrulewidth}{0.3pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{ocRule}\leaders\hrule height \headrulewidth\hfill}}

%% ---------------------------------------------------------------- toc
\RequirePackage{tocloft}
\renewcommand{\cfttoctitlefont}{\headingfont\fontsize{16}{19}\selectfont\color{ocDark}}
\renewcommand{\cftaftertoctitle}{\par\vspace{6pt}}
\renewcommand{\cftsecfont}{\headingfont\color{ocNavy}}
\renewcommand{\cftsecpagefont}{\sffamily\color{ocAccent}}
\renewcommand{\cftsubsecfont}{\color{ocBody}}
\renewcommand{\cftsubsecpagefont}{\sffamily\color{ocGray}}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\setlength{\cftbeforetoctitleskip}{0pt}
\setlength{\cftsecnumwidth}{1.7em}
\setlength{\cftsubsecnumwidth}{2.6em}
\renewcommand{\cftdotsep}{2.5}
\renewcommand{\cftdot}{\textcolor{ocRule}{.}}
\setlength{\cftbeforesecskip}{4pt}
\setlength{\cftbeforesubsecskip}{1.5pt}

%% ---------------------------------------------------------------- links
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=ocAccent,urlcolor=ocAccent!80!ocBody,citecolor=ocAccent,
  bookmarksnumbered=true,bookmarksopen=true}

%% ---------------------------------------------------------------- captions
\RequirePackage{float}
\RequirePackage[font=small,labelfont={bf,color=ocAccent},textfont={color=ocGray}]{caption}

%% ---------------------------------------------------------------- tikz
\RequirePackage{tikz}
\usetikzlibrary{calc}

%% ================================================================ COVER
%% #1 doc kind, #2 version, #3 date, #4 document id, #5 assignment line
\newcommand{\makecover}[5]{%
  \begin{titlepage}
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    \shade[top color=ocGradA,bottom color=ocGradC]
      (current page.north west) rectangle ([yshift=-11.5cm]current page.north east);
    \foreach \i in {0,1,...,14} {
      \draw[white,opacity=0.035,line width=0.5pt]
        ([xshift=\i*1.6cm,yshift=0cm]current page.north west) --
        ([xshift=\i*1.6cm+3cm,yshift=-11.5cm]current page.north west);
    }
    \foreach \i in {0,1,...,6} {
      \draw[white,opacity=0.025,line width=0.3pt]
        ([yshift=-\i*1.8cm]current page.north west) --
        ([yshift=-\i*1.8cm]current page.north east);
    }
    \fill[ocGold,opacity=0.9]
      ([yshift=-11.5cm]current page.north west) rectangle
      ([yshift=-11.56cm]current page.north east);
    \fill[ocGradC,opacity=0.15] ([xshift=14cm,yshift=-3cm]current page.north west) circle (5cm);
  \end{tikzpicture}%
  \begingroup
  \setlength{\parskip}{0pt}%
  \setlength{\parindent}{0pt}%
  \begin{flushleft}
    {\labelfont\fontsize{7.5}{9}\selectfont\color{white!70}%
      \MakeUppercase{Elements of Software Engineering}}\hfill
    {\labelfont\fontsize{7.5}{9}\selectfont\color{white!60}%
      \MakeUppercase{HCMUS \,\textbullet\, Class 24A01}}\par
    \vspace{2.2cm}
    {\headingfont\fontsize{52}{54}\selectfont\color{white} OmniCourse\par}
    \vspace{0.35cm}
    {\lightfont\fontsize{15}{18}\selectfont\color{ocGold!90!white}%
      Academic roadmap and course planner\par}
    \vspace{0.25cm}
    {\lightfont\fontsize{10}{13}\selectfont\color{white!55}%
     One workspace for the whole academic path of an HCMUS student\par}
  \end{flushleft}
  \vspace{2.0cm}
  \begin{flushleft}
    {\labelfont\fontsize{7.5}{9}\selectfont\color{ocSubtle}\MakeUppercase{Document}}\par
    \vspace{4pt}
    {\headingfont\fontsize{22}{26}\selectfont\color{ocDark} #1\par}
    \vspace{0.7cm}
    {\color{ocRule}\rule{\textwidth}{0.35pt}}\par
    \vspace{0.5cm}
    {\small\sffamily\color{ocBody}%
      \begin{tabularx}{\textwidth}{@{}p{4.3cm}X@{}}
        {\color{ocSubtle}Version} & #2\\
        {\color{ocSubtle}Date} & #3\\
        {\color{ocSubtle}Document identifier} & #4\\
        {\color{ocSubtle}Assignment} & #5\\
      \end{tabularx}\par}
    \vspace{1.2cm}
    {\labelfont\fontsize{7.5}{9}\selectfont\color{ocSubtle}\MakeUppercase{Team}}\par
    \vspace{6pt}
    \OmniCourseTeamTable
  \end{flushleft}
  \vfill
  \begin{flushleft}
    {\color{ocRule}\rule{\textwidth}{0.35pt}}\par
    \vspace{0.3cm}
    {\labelfont\fontsize{7}{8.5}\selectfont\color{ocSubtle}%
      \MakeUppercase{\OmniCourseCourse{} \;\textbullet\; HCMUS \;\textbullet\; Class 24A01}\par}
  \end{flushleft}
  \endgroup
  \end{titlepage}%
}

%% ---- Weekly report cover ----
%% #1 title, #2 period, #3 prepared by, #4 document id
\newcommand{\weeklycover}[4]{%
  \begin{titlepage}
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    \shade[top color=ocGradA,bottom color=ocGradC]
      (current page.north west) rectangle ([yshift=-10.5cm]current page.north east);
    \foreach \i in {0,1,...,14} {
      \draw[white,opacity=0.035,line width=0.5pt]
        ([xshift=\i*1.6cm,yshift=0cm]current page.north west) --
        ([xshift=\i*1.6cm+3cm,yshift=-10.5cm]current page.north west);
    }
    \fill[ocGold,opacity=0.9]
      ([yshift=-10.5cm]current page.north west) rectangle
      ([yshift=-10.56cm]current page.north east);
    \fill[ocGradC,opacity=0.12] ([xshift=15cm,yshift=-2.5cm]current page.north west) circle (4.5cm);
  \end{tikzpicture}%
  \begingroup
  \setlength{\parskip}{0pt}%
  \setlength{\parindent}{0pt}%
  \begin{flushleft}
    {\labelfont\fontsize{7.5}{9}\selectfont\color{white!70}%
      \MakeUppercase{Elements of Software Engineering}}\hfill
    {\labelfont\fontsize{7.5}{9}\selectfont\color{white!60}%
      \MakeUppercase{HCMUS \,\textbullet\, Class 24A01}}\par
    \vspace{1.6cm}
    {\headingfont\fontsize{40}{43}\selectfont\color{white} OmniCourse\par}
    \vspace{0.3cm}
    {\lightfont\fontsize{14}{17}\selectfont\color{ocGold!90!white} #1\par}
    \vspace{0.2cm}
    {\lightfont\fontsize{10}{13}\selectfont\color{white!55} #2\par}
  \end{flushleft}
  \vfill
  \begin{flushleft}
    {\small\sffamily\color{ocBody}%
      \begin{tabularx}{\textwidth}{@{}p{4.3cm}X@{}}
        {\color{ocSubtle}Group} & \OmniCourseGroup\\
        {\color{ocSubtle}Prepared by} & #3\\
        {\color{ocSubtle}Project} & OmniCourse (development name)\\
        {\color{ocSubtle}Document identifier} & #4\\
      \end{tabularx}}
  \end{flushleft}
  \vfill
  \begin{flushleft}
    {\color{ocRule}\rule{\textwidth}{0.35pt}}\par
    \vspace{0.3cm}
    {\footnotesize\sffamily\color{ocSubtle}\OmniCourseTeamShort\par}
  \end{flushleft}
  \endgroup
  \end{titlepage}%
}

\endinput
