          },
          "outOfDate": {
            "type": "boolean",
            "description": "Last checked more than 6 months ago, counted in Vietnam dates (UC-10 A5)"
          },
          "changeNote": {
            "type": "string"
          },
          "lastCheckedBy": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "when": {
            "$ref": "#/components/schemas/GuideWhenDto"
          },
          "appliesTo": {
            "type": "string"
          },
          "prepare": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuideItemDto"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuideItemDto"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuideNoteDto"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuideCitationDto"
            }
          },
          "ifPortalDown": {
            "type": [
              "string",
              "null"
            ]
          },
          "related": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuideLinkDto"
            }
          },
          "portals": {
            "description": "G01 only: every portal the other guides use",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuideBoardPortalDto"
            }
          }
        },
        "required": [
          "title",
          "keywords",
          "portal",
          "version",
          "lastCheckedOn",
          "outOfDate",
          "changeNote",
          "lastCheckedBy",
          "summary",
          "when",
          "appliesTo",
          "prepare",
          "steps",
          "notes",
          "citations",
          "ifPortalDown",
          "related",
          "portals"
        ]
      },
      "GuideTextsDto": {
        "type": "object",
        "properties": {
          "vi": {
            "$ref": "#/components/schemas/GuideTextDto"
          },
