# Backend
PORT=3000
# Behind a reverse proxy on this host (deploy/README.md): listen on loopback only and trust
# the proxy's X-Forwarded-For, so rate limits count each visitor. Leave unset in development.
# LISTEN_HOST=127.0.0.1
# TRUST_PROXY=loopback
DATABASE_URL=postgres://omnicourse:omnicourse@localhost:5432/omnicourse
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=7
ACCOUNT_DELETION_GRACE_DAYS=30
# Swagger pages at /api/docs: on unless NODE_ENV=production. true or false overrides.
API_DOCS=

# AI gateway (ADR 0003). Empty key: AI routes answer 503 ai_unavailable, the rest works.
OPENROUTER_API_KEY=
AI_MODEL_STRUCTURED=
AI_MODEL_CHAT=
# Per HTTP request to the provider, not per call. Blank or invalid values use the default.
AI_TIMEOUT_MS=30000
AI_DAILY_CALLS_PER_USER=20

# Frontend (Vite exposes only VITE_* variables)
VITE_API_URL=http://localhost:3000/api
