# Backend
PORT=3000
# Behind a reverse proxy on this host (deploy/README.md): listen on loopback only and trust
# the proxy's X-Forwarded-For, so rate limits count each visitor. Leave unset in development.
# LISTEN_HOST=127.0.0.1
# TRUST_PROXY=loopback
DATABASE_URL=postgres://omnicourse:omnicourse@localhost:5432/omnicourse
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=7
ACCOUNT_DELETION_GRACE_DAYS=30
# Swagger pages at /api/docs: on unless NODE_ENV=production. true or false overrides.
API_DOCS=

# AI gateway (ADR 0003). Empty key: AI routes answer 503 ai_unavailable, the rest works.
# AI_BASE_URL: unset for OpenRouter, or https://api.anthropic.com/v1/ for Anthropic. Any other
# value stops the backend from booting. OPENROUTER_API_KEY is still read when AI_API_KEY is empty.
AI_BASE_URL=
AI_API_KEY=
# Model ids of the provider, e.g. claude-haiku-5-5 (structured) and claude-sonnet-5-5 (chat) on Anthropic.
AI_MODEL_STRUCTURED=
AI_MODEL_CHAT=
# Output tokens per model request (thinking included on Anthropic).
AI_MAX_OUTPUT_TOKENS=8192
# Per HTTP request to the provider, not per call. Blank or invalid values use the default.
AI_TIMEOUT_MS=30000
AI_DAILY_CALLS_PER_USER=20

# Frontend (Vite exposes only VITE_* variables)
VITE_API_URL=http://localhost:3000/api
