{
  "name": "omnicourse",
  "private": true,
  "description": "One page for everything school related at HCMUS: degree audit, curriculum explorer, roadmap planner, AI planner.",
  "workspaces": [
    "src/backend",
    "src/frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:up": "podman compose up -d db || docker compose up -d db",
    "dev:backend": "npm run start:dev -w src/backend",
    "dev:frontend": "npm run dev -w src/frontend",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "@swc/core@1.16.18": true
  }
}
